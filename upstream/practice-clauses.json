      "unit_line": 95,
      "scope": "",
      "kind": "imperative",
      "found_by": "hand",
      "modals": [],
      "severities": [
        "WARNING"
      ],
      "text": "Provide `stop_sequence` whenever possible, as it unambiguously resolves to a GTFS stop time in `stop_times.txt` unlike `stop_id`, which can occur more than once in a trip (e.g., loop route).",
      "sha256": "f84414c697a22ee53a73bec931d5b28ab265428acb344e4a534484b75da8f869",
      "also_at": []
    },
    {
