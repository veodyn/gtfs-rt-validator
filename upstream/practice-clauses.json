      "kind": "table_row",
      "found_by": "pass_one",
      "modals": [
        "should"
      ],
      "severities": [
        "WARNING"
      ],
      "text": "Should uniquely and stably identify a vehicle over the entire trip duration",
      "sha256": "ef27cd2d380a35d9317eabfbee3e1fd2f097184831686e9973b4147479286813",
      "also_at": [
