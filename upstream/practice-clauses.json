      "scope": "",
      "kind": "table_row",
      "found_by": "pass_one",
      "modals": [
        "should"
      ],
      "severities": [
        "WARNING"
      ],
      "text": "Arrival times between sequential stops should increase - they should not be the same or decrease.",
      "sha256": "172d54de9ac4533a08df43fa1417dc87df76c1be3397d10948404253c91dd3f2",
      "also_at": []
    },
    {
