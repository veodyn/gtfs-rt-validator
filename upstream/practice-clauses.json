      "found_by": "pass_one",
      "modals": [
        "should"
      ],
      "severities": [
        "WARNING"
      ],
      "text": "Should reflect the time this prediction for this trip was updated.",
      "sha256": "696c37a6ea7f8aca3f3d43390700c200c5f064543c8626d9b6eb3ea2a14f8e02",
