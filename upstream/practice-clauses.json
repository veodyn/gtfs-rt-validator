      "found_by": "pass_one",
      "modals": [
        "should"
      ],
      "severities": [
        "WARNING"
      ],
      "text": "Departure times between sequential stops should increase - they should not be the same or decrease.",
      "sha256": "c804b6e734bdd74648896f9e747bfaf3000e29c86e5da2ac202a49a53bcaf584",
      "also_at": []
    },
    {
