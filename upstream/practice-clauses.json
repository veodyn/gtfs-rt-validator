      "found_by": "pass_one",
      "modals": [
        "should"
      ],
      "severities": [
        "WARNING"
      ],
      "text": "If the trip is a new or replacement trip, and the trip will run according to a schedule (which can be a modified schedule in case of a replacement trip), `scheduled_time` should be provided for all timepoints.",
