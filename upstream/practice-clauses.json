      "scope": "",
      "kind": "table_row",
      "found_by": "pass_one",
      "modals": [
        "should",
        "at least one"
      ],
      "severities": [
        "ERROR",
        "WARNING"
      ],
      "text": "While the trip is in progress, all `TripUpdates` should include at least one `stop_time_update` with a predicted arrival or departure time in the future.",
      "sha256": "fa5b1b54a21bcc7489aa7584c456cc41d3aea9ff86246d167337e788336607f0",
